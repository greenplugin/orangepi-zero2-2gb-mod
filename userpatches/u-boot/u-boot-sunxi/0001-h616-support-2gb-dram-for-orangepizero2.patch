+	printf("DRAM: Initialized %lu MB (ranks=%d, %d-bit, rows=%d, cols=%d)\n",
+	       size >> 20, para.ranks, para.bus_full_width ? 32 : 16, para.rows, para.cols);
+
 	return size;
